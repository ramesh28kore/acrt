# Copy to importer/.env (ignored by git). Nothing here is a secret for a local Supabase stack.
# Source export: the folder that contains topics.txt, statements_manifest.txt, statements_html/, mcq_json/, html/, urls.txt.
SCRAPER_DIR=D:\1.AVNT\1.Python\CCBP\scraper
# Styled cheat-sheet rebuild (<NN>_<Title>.html + .pdf). Defaults to <SCRAPER_DIR>/../course_cheat_sheets_styled.
CHEAT_SHEET_DIR=
# Where mcq answer keys (manual_answer_keys.json) live. Keep this folder out of git.
PRIVATE_DIR=importer/private
# Owner connection for the TARGET database. Local Supabase default shown.
IMPORT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosts the image downloader may contact (comma separated).
IMAGE_HOSTS=
